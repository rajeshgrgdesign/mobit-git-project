# Base REST URL of the WordPress install (RB Headless API plugin active),
# without a trailing slash. The plugin's namespace ("headless/v1") is
# appended automatically by the API client.
WORDPRESS_API_URL=https://cms.example.com/wp-json

# Shared secret required on requests to /api/revalidate. Configure the same
# value in the WordPress webhook (e.g. a save_post hook in the RB Headless
# API plugin, or a small mu-plugin) that POSTs here on publish/update.
REVALIDATE_SECRET=change-me
